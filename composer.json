{
    "name": "phparkitect/phparkitect",
    "description": "PHPArkitect - architecture testing for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Arkitect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arkitect\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "bin": [
        "bin/arkitect"
    ]
}
